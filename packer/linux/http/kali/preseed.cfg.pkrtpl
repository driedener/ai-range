#### Debian installer preseed for the template "kali"
# Rendered by Packer via templatefile() and served only from memory
# (http_content) - the password hash never touches disk.

### Localization
d-i debian-installer/locale string en_US.UTF-8
d-i debian-installer/language string en
d-i debian-installer/country string ${country}
d-i localechooser/supported-locales multiselect en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select ${keyboard}
d-i console-setup/ask_detect boolean false

### Network (DHCP in VLAN 21)
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string kali
d-i netcfg/get_domain string ${domain}
d-i netcfg/hostname string kali
d-i hw-detect/load_firmware boolean false

### Mirror
d-i mirror/country string manual
d-i mirror/http/hostname string http.kali.org
d-i mirror/http/directory string /kali
d-i mirror/http/proxy string
d-i mirror/suite string kali-rolling
d-i mirror/codename string kali-rolling
d-i apt-setup/use_mirror boolean true
d-i apt-setup/contrib boolean true
d-i apt-setup/non-free boolean true
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/services-select multiselect
d-i apt-setup/enable-source-repositories boolean false

### Clock
d-i clock-setup/utc boolean true
d-i time/zone string ${timezone}
d-i clock-setup/ntp boolean true

### Users: no root login, user "range"
d-i passwd/root-login boolean false
d-i passwd/make-user boolean true
d-i passwd/user-fullname string Range Admin
d-i passwd/username string range
d-i passwd/user-password-crypted password ${password_hash}
d-i user-setup/allow-password-weak boolean true
d-i user-setup/encrypt-home boolean false

### Partitioning: whole disk, one partition (simple for growpart when cloning)
d-i partman-auto/disk string /dev/sda
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-lvm/device_remove_lvm boolean true
d-i partman-md/device_remove_md boolean true
d-i partman-lvm/confirm boolean true
d-i partman-lvm/confirm_nooverwrite boolean true
d-i partman-basicfilesystems/no_swap boolean false
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

### Packages
tasksel tasksel/first multiselect standard
d-i pkgsel/include string ${kali_metapackage} qemu-guest-agent cloud-init cloud-initramfs-growroot openssh-server sudo curl ca-certificates
d-i pkgsel/upgrade select full-upgrade
d-i pkgsel/update-policy select none
popularity-contest popularity-contest/participate boolean false
# Suppress the Wireshark question from kali-linux-headless/default
wireshark-common wireshark-common/install-setuid boolean true
kismet-capture-common kismet-capture-common/install-setuid boolean true
kismet-capture-common kismet-capture-common/install-users string
sslh sslh/inetd_or_standalone select standalone
macchanger macchanger/automatically_run boolean false

### Bootloader
d-i grub-installer/only_debian boolean true
d-i grub-installer/with_other_os boolean false
d-i grub-installer/bootdev string /dev/sda

### Post-install
# - sudo NOPASSWD for range
# - enable SSH (Kali does not enable network services automatically) + password login
# - cloud-init datasource for Proxmox
d-i preseed/late_command string \
    echo 'range ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/range ; \
    chmod 0440 /target/etc/sudoers.d/range ; \
    mkdir -p /target/etc/ssh/sshd_config.d ; \
    echo 'PasswordAuthentication yes' > /target/etc/ssh/sshd_config.d/01-range.conf ; \
    mkdir -p /target/etc/cloud/cloud.cfg.d ; \
    echo 'datasource_list: [ NoCloud, ConfigDrive ]' > /target/etc/cloud/cloud.cfg.d/99-pve.cfg ; \
    printf 'allow-hotplug eth0\niface eth0 inet dhcp\n' > /target/etc/network/interfaces.d/99-packer-build ; \
    in-target systemctl enable ssh ; \
    in-target systemctl enable qemu-guest-agent || true

### Finish
d-i finish-install/reboot_in_progress note
d-i cdrom-detect/eject boolean true
