# Windows 11 Enterprise Evaluation (90-day evaluation) - OVMF + vTPM 2.0 + Secure Boot
# ISO from scripts/proxmox/download-isos.sh, on proxmox.iso_storage from range.yaml.
# VMID per node: range.yaml (proxmox.templates.win11.vm_ids)
#
# Other ISO/edition (e.g. consumer multi-edition media)? Do not edit this file - create win11.pkrvars.local.hcl
# (git-ignored, loaded after this file by build.sh), e.g.:
#   iso_name    = "en-us_windows_11_consumer_editions_..._x64_dvd_....iso"
#   image_name  = "Windows 11 Pro"
#   product_key = "VK7JG-NPHTM-C97JM-9MPGT-3V66T"   # public generic key for Pro, selects the edition only
template_name = "win11"
iso_name      = "WIN11_ENTERPRISE_EVAL_x64FRE_en-us.iso"
image_name    = "Windows 11 Enterprise Evaluation"
product_key   = ""
virtio_os     = "w11"
is_client     = true
memory        = 4096
cores         = 2
disk_size     = "64G"
