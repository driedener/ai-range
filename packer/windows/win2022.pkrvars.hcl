# Windows Server 2022 Standard Evaluation (Desktop Experience), 180-day evaluation
# ISO from scripts/proxmox/download-isos.sh, on proxmox.iso_storage from range.yaml.
# VMID per node: range.yaml (proxmox.templates.win2022.vm_ids)
#
# Other ISO/edition (e.g. volume license media)? Do not edit this file - create win2022.pkrvars.local.hcl
# (git-ignored, loaded after this file by build.sh), e.g.:
#   iso_name    = "en-us_windows_server_2022_..._x64_dvd_....iso"
#   image_name  = "Windows Server 2022 Standard (Desktop Experience)"
#   product_key = "VDYBN-27WPP-V4HQT-9VMD4-VMK7H"   # public KMS client key (GVLK), activates nothing
template_name = "win2022"
iso_name      = "SERVER_EVAL_x64FRE_en-us.iso"
image_name    = "Windows Server 2022 Standard Evaluation (Desktop Experience)"
# install.wim order on Server 2022 media: 1 Std Core, 2 Std Desktop, 3 DC Core, 4 DC Desktop.
# Selecting by index is more robust than by name ("There are no matching OS images").
image_index   = 2
product_key   = ""
virtio_os     = "2k22"
is_client     = false
memory        = 4096
cores         = 2
disk_size     = "60G"
