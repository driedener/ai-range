# Copy to docker/.env and fill in. Do NOT commit docker/.env.
# Secrets and runtime settings only - names, networks and IPs (controller, Proxmox, VMs) live in range.yaml.
# Random values (Linux/macOS):  openssl rand -base64 30 | tr -d '/+=' | cut -c1-32

# --- Elastic -----------------------------------------------------------------
# Check the current 9.x release before the first start (the agents on the VMs use the same version)
ELASTIC_VERSION=9.2.0
ELASTIC_PASSWORD=change-me
KIBANA_PASSWORD=change-me-too
# at least 32 characters
KIBANA_ENCRYPTION_KEY=change-me-change-me-change-me-32chars
# trial (all features for 30 days) or basic
LICENSE=trial
ES_HEAP=12g
ES_MEM_LIMIT=24g

# --- Proxmox (endpoint in range.yaml) ------------------------------------------
PROXMOX_VE_API_TOKEN=terraform@pve!tf=00000000-0000-0000-0000-000000000000
PROXMOX_VE_INSECURE=true

# --- Range credentials (Packer templates + Ansible) ----------------------------
# Local Administrator (Windows) and user "range" (Linux) in the templates,
# also the domain Administrator after the forest is created
RANGE_ADMIN_PASSWORD=Ch4nge-Me-Admin!
# Directory Services Restore Mode
RANGE_DSRM_PASSWORD=Ch4nge-Me-Dsrm!
# Default password of the generated AD users
RANGE_USER_PASSWORD=Ch4nge-Me-User!
# Tier-0 admins adm.* (Domain Admins) - separate password, otherwise spraying the user password leads straight to DA
RANGE_TIER0_PASSWORD=Ch4nge-Me-Tier0!

# --- Elastic users of the AI agents (ansible/playbooks/elastic-config.yml) -----
# blue-agent: reads telemetry/alerts, NO access to the ground truth
RANGE_BLUE_PASSWORD=change-me-blue
# red-agent: only writes ground truth + agent traces
RANGE_RED_PASSWORD=change-me-red
RANGE_ORCH_PASSWORD=change-me-orch

# --- AI agents (service "agents") ---------------------------------------------
# One of the two: API key (console.anthropic.com) or subscription token ("claude setup-token")
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
AIRANGE_MODEL=claude-opus-5-5
# Optional per role, empty = AIRANGE_MODEL:
# AIRANGE_RED_MODEL=
# AIRANGE_BLUE_MODEL=
# AIRANGE_ENGINEER_MODEL=
# Cost limit per agent run (USD)
AIRANGE_MAX_BUDGET_USD=5
AIRANGE_RED_MAX_BUDGET_USD=10
# Blue response actions (isolate/kill): auto | off
AIRANGE_BLUE_RESPONSE=auto
# Exercise flow: sequential (Red -> wait -> Blue) | parallel (Blue monitors live while Red attacks).
# Override per call: exercise --mode parallel. In parallel mode Blue runs as long as Red plus --wait-min,
# so set the budget higher (AIRANGE_MAX_BUDGET_USD or --budget).
AIRANGE_EXERCISE_MODE=sequential

# --- Security platform: elastic (default) | sentinelone ------------------------
# sentinelone: Ansible installs the S1 agent instead of Elastic Agent/Defend (installers in
# sources/sentinelone/installer), Blue/Engineer/Scorer work against the S1 console.
# Ground truth, agent traces and scores stay in the Elastic stack. Details: docs/sentinelone.md
AIRANGE_EDR=elastic
# Console URL without path, e.g. https://<tenant>.sentinelone.net
S1_CONSOLE_URL=
# Service user token (site scope = range, role e.g. "SOC") for Blue/Engineer and Ansible
S1_API_TOKEN=
# Optional: separate token with role "Viewer" for the scorer (otherwise S1_API_TOKEN)
S1_ORCH_API_TOKEN=
# Site of the range (Settings > Sites); limits queries, response actions and new rules
S1_SITE_ID=
# Optional: site token for the installation (empty = read via API from S1_SITE_ID)
S1_SITE_TOKEN=
# Password of the AD account svc.s1identity (identity connector, read-only); separate, long password
S1_AD_PASSWORD=
