# Secrets
docker/.env
*.tfvars
!*.tfvars.example

# Your environment (copy range.example.yaml to range.yaml)
/range.yaml

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
.terraform.lock.hcl.bak
crash.log

# Packer
**/packer_cache/
# Local overrides (your own ISO names, editions, keys)
*.pkrvars.local.hcl
*.auto.pkrvars.hcl

# Ansible
*.retry

# Generated by scripts/configure.py from range.yaml
ansible/inventory/range.yml
docker/range.env
ca.crt

# Download cache (Ansible controller)
ansible/.cache/

# Vendor installers, docs and API specs (large, licensed) - local only
sources/sentinelone/installer/
sources/sentinelone/api/
sources/**/*.pdf
# SentinelOne GraphQL schemas, pulled from your console with "agents s1-schema"
agents/schema/

# Range state (applied vuln_* profiles per snapshot) - local, written by Ansible/agents
agents/state/

# Docs build output (Zensical)
site/

# Python
__pycache__/
*.pyc
.venv/
